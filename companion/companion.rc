#include <windows.h>
301 ICON "icon.ico"
1 VERSIONINFO
FILEVERSION SF_VERSION_COMMAS
PRODUCTVERSION SF_VERSION_COMMAS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Simforever Companion\0"
            VALUE "ProductName", "Simforever Companion\0"
            VALUE "FileVersion", SF_VERSION "\0"
            VALUE "ProductVersion", SF_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
